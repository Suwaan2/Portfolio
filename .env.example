# Server-side only. Never expose to the browser (do NOT prefix with VITE_).
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-flash-latest

# Optional: protect GET /api/ai/analytics with a bearer token.
# Leave unset to make the analytics endpoint public.
ANALYTICS_KEY=

# Portfolio content (MongoDB Atlas). Without MONGODB_URI the site and chatbot use data/portfolio/*.json.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/
MONGODB_DB=portfolio
# Local only: set if `npm run seed` fails with "querySrv ECONNREFUSED" (Node can't use your router's DNS)
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8