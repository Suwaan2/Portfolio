{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": { "includeFiles": "data/portfolio/**" }
  },
  "headers": [
    { "source": "/admin(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites":[{ "source": "/(.*)", "destination": "/index.html" }]
}
